---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';

const events = (await getCollection('timeline')).sort(
  (a, b) => b.data.start.valueOf() - a.data.start.valueOf()
);

const kinds = [...new Set(events.map((e) => e.data.kind))].sort();
const yr = (d: Date | null) => (d ? d.getFullYear() : 'present');

const span = (start: Date, end: Date | null) => {
  const a = yr(start);
  const b = yr(end);
  return a === b ? `${a}` : `${a}–${b}`;
};
---

<Base title="Timeline" description="Career, education, publications, talks and projects.">
  <h1>Timeline</h1>
  <p class="lede">Everything, most recent first.</p>

  <FilterBar noun="event" groups={[{ label: 'kind', name: 'kind', options: kinds, dots: true }]} />

  {
    events.length === 0 ? (
      <p class="empty">Nothing here yet.</p>
    ) : (
      <ol class="spine">
        {events.map((e) => (
          <li
            class="ev"
            data-item
            data-kind={e.data.kind}
            style={`--dot: var(--${e.data.kind})`}
          >
            <span class="ev-years">{span(e.data.start, e.data.end)}</span>
            <div class="ev-body">
              <span class="kind">{e.data.kind}</span>
              <div class="ev-title">
                {e.data.url ? <a href={e.data.url}>{e.data.title}</a> : e.data.title}
              </div>
              {e.data.org && <div class="meta">{e.data.org}</div>}
              {e.data.blurb && <p class="meta">{e.data.blurb}</p>}
            </div>
          </li>
        ))}
      </ol>
    )
  }
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';
import { eventLabel, isOngoing } from '../lib/dates';

/**
 * Ongoing first, then most recent start. Sorting on start alone buried the
 * current role under a talk and a workshop that started later in 2026 but
 * have since finished - what you're doing now should lead.
 */
const byRecency = (a: { data: any }, b: { data: any }) => {
  const ao = Number(isOngoing(a.data.kind, a.data.end));
  const bo = Number(isOngoing(b.data.kind, b.data.end));
  if (ao !== bo) return bo - ao;
  return b.data.start.valueOf() - a.data.start.valueOf();
};

const events = (await getCollection('timeline')).sort(byRecency);

const kinds = [...new Set(events.map((e) => e.data.kind))].sort();

// Group by start year. The year becomes a single anchor per group instead of
// repeating on every row next to a date range that already states it.
const years = [...new Set(events.map((e) => e.data.start.getUTCFullYear()))].sort(
  (a, b) => b - a
);
const byYear = years.map((year) => ({
  year,
  items: events.filter((e) => e.data.start.getUTCFullYear() === year).sort(byRecency),
}));
---

<Base title="Timeline" description="Career, education, publications, awards and community work.">
  <h1>Timeline</h1>
  <p class="lede">Everything, most recent first.</p>

  <FilterBar total={events.length} noun="event" groups={[{ label: 'kind', name: 'kind', options: kinds, dots: true }]} />

  {
    events.length === 0 ? (
      <p class="empty">Nothing here yet.</p>
    ) : (
      <div class="spine">
        {byYear.map((group) => (
          <section class="year-group" data-section>
            <h2 class="year-marker">{group.year}</h2>
            <ol class="year-events">
              {group.items.map((e) => (
                <li class="ev" data-item data-kind={e.data.kind} style={`--dot: var(--${e.data.kind})`}>
                  <span class="kind">{e.data.kind}</span>
                  <div class="ev-title">
                    {e.data.url ? <a href={e.data.url}>{e.data.title}</a> : e.data.title}
                  </div>
                  <div class="meta">
                    {e.data.org && <span>{e.data.org}</span>}
                    {e.data.org && ' · '}
                    <span class="mono">
                      {eventLabel(e.data.kind, e.data.start, e.data.end, e.data.precision)}
                    </span>
                  </div>
                  {e.data.detail && <div class="meta detail">{e.data.detail}</div>}
                  {e.data.blurb && <p class="meta">{e.data.blurb}</p>}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    )
  }
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
const posts = (await getCollection('writing', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 5);
const events = await getCollection('timeline');
const career = events.filter((e) => e.data.kind === 'career')
  .sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
const publications = events.filter((e) => e.data.kind === 'publication');
const interests = [
  'LLM agents and the tooling around them',
  'Model interpretability',
  'Search, retrieval and ranking',
  'Databases and things that have to stay up',
];
// TODO(suban): drop resume.pdf into public/ and this link appears on its own.
const hasResume = fs.existsSync('public/resume.pdf');
const yr = (d: Date | null) => (d ? d.getFullYear() : 'present');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base>
  <h1>Suban Shrestha</h1>
  <p>Software engineer. Messy, sporadic, but gets things done.</p>

  <h2>Interests</h2>
  <ul>{interests.map((i) => <li>{i}</li>)}</ul>

  {publications.length > 0 && (
    <>
      <h2>Publications</h2>
      <ul class="post-list">
        {publications.map((p) => (
          <li>{p.data.url ? <a href={p.data.url}>{p.data.title}</a> : p.data.title}
          <span class="meta">{yr(p.data.start)}</span></li>
        ))}
      </ul>
    </>
  )}

  <h2>Career</h2>
  <ul class="post-list">
    {career.map((c) => (
      <li><span>{c.data.title}{c.data.org && <span class="meta"> · {c.data.org}</span>}</span>
      <span class="meta">{yr(c.data.start)}–{yr(c.data.end)}</span></li>
    ))}
  </ul>
  <p class="meta"><a href="/timeline">Full timeline →</a></p>

  <h2>Recent writing</h2>
  <ul class="post-list">
    {posts.map((p) => (
      <li><a href={`/writing/${p.id}`}>{p.data.title}</a>
      <time class="meta" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></li>
    ))}
  </ul>
  <p class="meta"><a href="/writing">All writing →</a></p>

  <h2>Contact</h2>
  <p>
    <a href="mailto:subanshrestha244@gmail.com">subanshrestha244@gmail.com</a> ·
    <a href="https://github.com/suban244">GitHub</a>
    {hasResume && <> · <a href="/resume.pdf">Résumé</a></>}
  </p>
</Base>

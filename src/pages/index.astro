---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import fs from 'node:fs';

const posts = (await getCollection('writing', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const events = await getCollection('timeline');
const career = events
  .filter((e) => e.data.kind === 'career')
  .sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
const publications = events
  .filter((e) => e.data.kind === 'publication')
  .sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());

// TODO(suban): drop resume.pdf into public/ and this link appears on its own.
const hasResume = fs.existsSync('public/resume.pdf');

const interests = [
  'LLM agents and the tooling around them',
  'Model interpretability',
  'Search, retrieval and ranking',
  'Databases and things that have to stay up',
];

const yr = (d: Date | null) => (d ? d.getFullYear() : 'present');
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base>
  <div class="hero">
    <h1>Suban Shrestha</h1>
    <p class="lede">
      Software engineer in Kathmandu. Messy, sporadic, but gets things done.
    </p>
    <p class="links">
      <a href="mailto:subanshrestha244@gmail.com">email</a>
      <a href="https://github.com/suban244">github</a>
      {hasResume && <a href="/resume.pdf">résumé</a>}
      <a href="/rss.xml">rss</a>
    </p>
  </div>

  <section class="section">
    <h2>Interests</h2>
    <ul class="interests">{interests.map((i) => <li>{i}</li>)}</ul>
  </section>

  {publications.length > 0 && (
    <section class="section">
      <h2>Publications</h2>
      <ul class="post-list">
        {publications.map((p) => (
          <li>
            <div class="entry">
              {p.data.url ? (
                <a class="entry-title" href={p.data.url}>{p.data.title}</a>
              ) : (
                <span class="entry-title">{p.data.title}</span>
              )}
              <span class="entry-date">{yr(p.data.start)}</span>
              {p.data.org && <div class="entry-sub meta">{p.data.org}</div>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {career.length > 0 && (
    <section class="section">
      <h2>Career</h2>
      <ul class="post-list">
        {career.map((c) => (
          <li>
            <div class="entry">
              <span class="entry-title">{c.data.title}</span>
              <span class="entry-date">{yr(c.data.start)}–{yr(c.data.end)}</span>
              {c.data.org && <div class="entry-sub meta">{c.data.org}</div>}
            </div>
          </li>
        ))}
      </ul>
      <p class="section-more"><a href="/timeline">full timeline →</a></p>
    </section>
  )}

  <section class="section">
    <h2>Recent writing</h2>
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <div class="entry">
            <a class="entry-title" href={`/writing/${p.id}`}>{p.data.title}</a>
            <time class="entry-date" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            <div class="entry-sub">
              <span class="kind">{p.data.kind}</span>
              {p.data.tags.map((t) => <a class="tag" href={`/tags/${t}`}>{t}</a>)}
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="section-more"><a href="/writing">all writing →</a></p>
  </section>
</Base>

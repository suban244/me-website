---
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/dates';
import Base from '../../layouts/Base.astro';
import FilterBar from '../../components/FilterBar.astro';

const posts = (await getCollection('writing', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const kinds = [...new Set(posts.map((p) => p.data.kind))].sort();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

---

<Base title="Writing" description="Notes, essays and things I learned along the way.">
  <h1>Writing</h1>
  <p class="lede">
    {posts.length} pieces — mostly notes on what I've been reading, occasionally something longer.
  </p>

  <FilterBar
    total={posts.length}
    noun="piece"
    groups={[
      { label: 'kind', name: 'kind', options: kinds },
      { label: 'tag', name: 'tags', options: tags },
    ]}
  />

  <ul class="post-list">
    {
      posts.map((p) => (
        <li data-item data-kind={p.data.kind} data-tags={p.data.tags.join(' ')}>
          <div class="entry">
            <a class="entry-title" href={`/writing/${p.id}`}>
              {p.data.title}
            </a>
            <time class="entry-date" datetime={p.data.date.toISOString()}>
              {formatDate(p.data.date)}
            </time>
            <div class="entry-sub">
              <span class="kind">{p.data.kind}</span>
              {p.data.tags.map((t) => (
                <a class="tag" href={`/tags/${t}`}>
                  {t}
                </a>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Base>
